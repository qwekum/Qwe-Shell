<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>None</DebugType>
    <AssemblyName>ShellStudio.SandboxHarness</AssemblyName>
    <RootNamespace>ShellStudioSandboxHarness</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- These are intentionally file references. The guest harness must not trigger a shared Studio/Core build. -->
    <Reference Include="ShellStudio">
      <HintPath>..\..\..\bin\studio\ShellStudio.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ShellStudio.Core">
      <HintPath>..\..\..\bin\studio\ShellStudio.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ShellStudio.Tools">
      <HintPath>..\..\..\bin\studio\ShellStudio.Tools.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\..\bin\studio\ShellStudio.Language.dll"
          Link="ShellStudio.Language.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\bin\studio\ShellStudio.PreviewWorker.exe"
          Link="ShellStudio.PreviewWorker.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
