<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NativeLanguagePath Condition="'$(NativeLanguagePath)' == ''">$(MSBuildThisFileDirectory)..\native\bin\Release\x64\ShellStudio.Language.dll</NativeLanguagePath>
    <PreviewWorkerPath Condition="'$(PreviewWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\native\bin\Release\x64\ShellStudio.PreviewWorker.exe</PreviewWorkerPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ShellStudio.Core/ShellStudio.Core.csproj" />
    <Compile Include="../ShellStudio/PreviewReadBroker.cs" Link="PreviewReadBroker.cs" />
    <Compile Include="../ShellStudio/PreviewWorkerClient.cs" Link="PreviewWorkerClient.cs" />
    <Compile Include="../ShellStudio/PreviewWorkspaceSemanticResolver.cs" Link="PreviewWorkspaceSemanticResolver.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NativeLanguagePath)" Link="ShellStudio.Language.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeLanguagePath)')" />
    <None Include="$(PreviewWorkerPath)" Link="ShellStudio.PreviewWorker.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(PreviewWorkerPath)')" />
  </ItemGroup>
  <Target Name="RequireNativeTestPrerequisites" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NativeLanguagePath)')" Text="Core tests require NativeLanguagePath to point to the exact built ShellStudio.Language.dll. Missing: $(NativeLanguagePath)" />
    <Error Condition="!Exists('$(PreviewWorkerPath)')" Text="Core tests require PreviewWorkerPath to point to the exact built ShellStudio.PreviewWorker.exe. Missing: $(PreviewWorkerPath)" />
  </Target>
</Project>
