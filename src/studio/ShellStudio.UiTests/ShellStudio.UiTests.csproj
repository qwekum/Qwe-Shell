<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <NativeLanguagePath Condition="'$(NativeLanguagePath)' == ''">$(MSBuildThisFileDirectory)..\native\bin\Release\x64\ShellStudio.Language.dll</NativeLanguagePath>
    <!-- Build StudioCaptureSerializationTests.vcxproj Release/x64 first; override with its exact executable path. -->
    <NativeCaptureFixturePath Condition="'$(NativeCaptureFixturePath)' == ''">$(MSBuildThisFileDirectory)..\native\tests\bin\Release\x64\StudioCaptureSerializationTests.exe</NativeCaptureFixturePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShellStudio\ShellStudio.csproj" />
    <None Include="$(NativeLanguagePath)" Link="ShellStudio.Language.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeLanguagePath)')" />
    <None Include="$(NativeCaptureFixturePath)" Link="StudioCaptureSerializationTests.exe" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <Target Name="RequireNativeCaptureFixture" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NativeCaptureFixturePath)')" Text="Build StudioCaptureSerializationTests.vcxproj (Release/x64) first, then set NativeCaptureFixturePath to that executable. Missing: $(NativeCaptureFixturePath)" />
  </Target>
</Project>
