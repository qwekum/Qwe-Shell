<Window x:Class="ShellStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ShellStudio.Core;assembly=ShellStudio.Core" Title="Shell Studio" Width="1320" Height="860" MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="170" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="Shell Studio" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Make the menu yours." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Open configuration" Click="Open_Click" ToolTip="Open configuration (Ctrl+O)" /><Button Content="Capture menu" x:Name="CaptureButton" Click="Capture_Click" ToolTip="Capture a menu from Explorer (F5)" /><Button Content="Review &amp; apply" Click="Apply_Click" Background="#294F46" /><Button Content="Light / dark" Click="Theme_Click" /></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Padding="12,9" Background="{DynamicResource PanelBrush}" CornerRadius="6" Margin="0,0,0,16">
      <DockPanel><TextBlock x:Name="PhaseLabel" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Text="NO MENU CAPTURED" Margin="16,0,0,0" /><TextBlock x:Name="ContextLabel" Text="Open a configuration or capture a context menu to begin." TextTrimming="CharacterEllipsis" /></DockPanel>
    </Border>
    <TabControl Grid.Row="2" x:Name="Pages">
      <TabItem Header="Menu editor">
        <Grid Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12"><Button Content="+ Command" Click="AddCommand_Click" /><Button Content="+ Submenu" Click="AddMenu_Click" /><Button Content="+ Separator" Click="AddSeparator_Click" /><Button Content="Remove" Click="Remove_Click" /><Button Content="↑" Click="MoveUp_Click" ToolTip="Move up (Alt+Up)" /><Button Content="↓" Click="MoveDown_Click" ToolTip="Move down (Alt+Down)" /><Button Content="Undo" Click="Undo_Click" /><Button Content="Redo" Click="Redo_Click" /></WrapPanel>
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
              <Grid><TextBlock x:Name="EmptyMenu" Text="Capture the menu you want to customize.&#10;&#10;Then drag entries to reorder them, or select one to edit its properties." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" />
              <TreeView x:Name="MenuTree" SelectedItemChanged="Menu_Selected" AllowDrop="True" PreviewMouseLeftButtonDown="Menu_MouseDown" PreviewMouseMove="Menu_MouseMove" DragOver="Menu_DragOver" Drop="Menu_Drop" AutomationProperties.Name="Context menu editing surface">
                <TreeView.Resources>
                  <HierarchicalDataTemplate DataType="{x:Type core:MenuEntry}" ItemsSource="{Binding Children}">
                    <Grid MinWidth="310" AutomationProperties.Name="{Binding DisplayTitle}">
                      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Disabled}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="⋮" /><Setter Property="Opacity" Value="0.45" /><Style.Triggers><DataTrigger Binding="{Binding Checked}" Value="True"><Setter Property="Text" Value="✓" /><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Open this submenu during capture to load its entries" FontSize="10" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ChildrenCaptured}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,2,0"><TextBlock Text="{Binding DiagnosticBadge}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,8,0" /><TextBlock Text="{Binding Origin}" Foreground="{DynamicResource MutedBrush}" FontSize="10" /></StackPanel>
                    </Grid>
                  </HierarchicalDataTemplate>
                </TreeView.Resources>
              </TreeView></Grid>
            </Border>
            <TextBlock Grid.Row="2" x:Name="DragHint" Text="Drag above/below an entry to reorder. Hold Shift while dropping on a submenu to move inside it." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,10,0,0" FontSize="12" />
          </Grid>
          <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Entry properties" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="Rule scope for native and new entries" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" /><ComboBox x:Name="ScopeBox" SelectedIndex="0"><ComboBoxItem Content="This context category" /><ComboBoxItem Content="All matching menus" /><ComboBoxItem Content="This exact path" /></ComboBox>
            <TextBlock x:Name="SelectedTitle" Text="Select an entry" FontSize="16" Margin="0,20,0,8" TextWrapping="Wrap" />
            <StackPanel x:Name="PropertyPanel" />
            <Button Content="Explain this entry" Click="Explain_Click" Margin="0,15,0,0" HorizontalAlignment="Left" />
            <Button Content="Inspect original menu" Click="InspectOriginal_Click" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="Inspect captured entries before filtering, including entries missing from the final menu" />
            <TextBlock x:Name="SourceLabel" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,0" />
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Expression canvas"><ContentControl x:Name="ExpressionContent" Margin="0,16,0,12" /></TabItem>
      <TabItem Header="Appearance &amp; settings"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,12"><StackPanel x:Name="SettingsPanel" /></ScrollViewer></TabItem>
      <TabItem Header="Integrated tools"><ContentControl x:Name="ToolsContent" Margin="0,16,0,12" /></TabItem>
      <TabItem Header="Templates"><StackPanel Margin="20"><TextBlock Text="Reusable menus and appearance" FontSize="22" Margin="0,0,0,10" /><TextBlock Text="Save a menu or selection, then load it into another workspace. System changes stay separate." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20" /><WrapPanel><Button Content="Save managed customization" Click="SaveTemplate_Click" /><Button Content="Save selected submenu" Click="SaveSelectionTemplate_Click" /><Button Content="Load template" Click="LoadTemplate_Click" /><Button Content="Starter templates" Click="StarterTemplate_Click" /></WrapPanel><TextBlock x:Name="TemplateInfo" TextWrapping="Wrap" Margin="0,20,0,0" /></StackPanel></TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12,8"><DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="Diagnostics" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Clear history" Click="ClearDiagnostics_Click" Padding="8,3" /><Button Content="Open imported file" Click="OpenImport_Click" Padding="8,3" /><Button Content="Load recorded capture" Click="LoadCapture_Click" Padding="8,3" /><Button Content="Export report" Click="ExportReport_Click" Padding="8,3" /></StackPanel></DockPanel>
      <ListBox x:Name="DiagnosticList" MouseDoubleClick="Diagnostic_Click" AutomationProperties.Name="Configuration and operation diagnostics"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock TextWrapping="Wrap"><Run Text="{Binding Code}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message}" /></TextBlock><TextBlock Text="{Binding Remedy}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel></Border>
    <TextBlock Grid.Row="4" x:Name="StatusLabel" Text="Ready. No system changes have been applied." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" />
  </Grid>
</Window>
