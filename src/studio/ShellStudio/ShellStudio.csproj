<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ShellStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <NativeLanguagePath Condition="'$(NativeLanguagePath)' == ''">../native/bin/Release/x64/ShellStudio.Language.dll</NativeLanguagePath>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ShellStudio.Core/ShellStudio.Core.csproj" /><ProjectReference Include="../ShellStudio.Tools/ShellStudio.Tools.csproj" /></ItemGroup>
  <ItemGroup><None Include="$(NativeLanguagePath)" Link="ShellStudio.Language.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeLanguagePath)')" /></ItemGroup>
  <ItemGroup>
    <Content Include="../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
